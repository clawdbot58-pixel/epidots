# epidots bashrc — linked to ~/.bashrc and ~/.profile by install.sh.
# Interactive shells only.
case $- in *i*) ;; *) return ;; esac

export PATH="$HOME/.nix-profile/bin:$HOME/afs/.confs/bin:$PATH"

# prompt
PS1='\[\e[1;36m\]\u@\h\[\e[0m\]:\[\e[1;33m\]\w\[\e[0m\]\$ '

# history
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend cmdhist

# completions (package from manifest, if installed)
if [ -f "$HOME/.nix-profile/share/bash-completion/bash_completion" ]; then
  . "$HOME/.nix-profile/share/bash-completion/bash_completion"
fi

# fzf keybindings: Ctrl-R history, Ctrl-T files, Alt-C cd
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash 2>/dev/null)" || true
fi

# ls / bat
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -l --group-directories-first --git'
  alias la='eza -la --group-directories-first --git'
  alias lt='eza --tree --level=2'
else
  alias ls='ls --color=auto'
  alias ll='ls -la'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'

# cd into git root
cdg() { git rev-parse --show-toplevel 2>/dev/null && cd "$(git rev-parse --show-toplevel)"; }

# quick copy of files to clipboard (needs xclip/xsel on PATH, guarded)
copy() { command -v xclip >/dev/null 2>&1 && cat "$@" | xclip -selection clipboard; }
