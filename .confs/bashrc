# epidots bashrc — linked to ~/.bashrc by apply(). Bash stays vanilla:
# zsh is the interactive shell (handed over below); this file only keeps
# a working prompt if zsh is unavailable.
export PATH="$HOME/.nix-profile/bin:$HOME/afs/.confs/bin:$PATH"

case $- in *i*) ;; *) return ;; esac

# interactive non-login shells (terminal, tmux): hand over to zsh once,
# unless this bash was started by zsh — an explicit `bash` stays bash.
if [ "$(ps -o comm= -p "$PPID" 2>/dev/null)" != "zsh" ] &&
   [ -x "$HOME/.nix-profile/bin/zsh" ]; then
  exec "$HOME/.nix-profile/bin/zsh" -l
fi

# fallback prompt (only reached when zsh is not installed yet)
PS1='\[\e[1;36m\]\u@\h\[\e[0m\]:\[\e[1;33m\]\w\[\e[0m\]\$ '
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend cmdhist

if [ -f "$HOME/.nix-profile/share/bash-completion/bash_completion" ]; then
  . "$HOME/.nix-profile/share/bash-completion/bash_completion"
fi
command -v eza >/dev/null 2>&1 && alias ls='eza --group-directories-first'
