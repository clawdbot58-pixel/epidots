# epidots zshrc — linked to ~/.zshrc by install.sh.
export PATH="$HOME/.nix-profile/bin:$HOME/afs/.confs/bin:$PATH"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY IGNORE_DUPS EXTENDED_GLOB AUTO_CD

# completion
autoload -Uz compinit
compinit -d "${TMPDIR:-/tmp}/.zcompdump-$USER"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# plugins (from the rice profile, if installed)
[ -f "$HOME/.nix-profile/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \
  . "$HOME/.nix-profile/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
[ -f "$HOME/.nix-profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && \
  . "$HOME/.nix-profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# fzf: Ctrl-R history, Ctrl-T files, Alt-C cd
command -v fzf >/dev/null 2>&1 && eval "$(fzf --zsh 2>/dev/null)" || true

# prompt (plain fallback if starship missing)
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
else
  PROMPT='%F{cyan}%n@%m%f:%F{yellow}%~%f$ '
fi

# aliases
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -l --group-directories-first --git'
  alias la='eza -la --group-directories-first --git'
  alias lt='eza --tree --level=2'
else
  alias ls='ls --color=auto'
  alias ll='ls -la'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
cdg() { git rev-parse --show-toplevel 2>/dev/null && cd "$(git rev-parse --show-toplevel)"; }
